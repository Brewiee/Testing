#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: be
  timezone: "Europe/Brussels"
  source:
    id: ubuntu-desktop
  storage:
    layout:
      name: direct
  identity:
    hostname: ubuntu-oem
    username: oem
    password: '$6$rounds=4096$saltsalt$hash'  # Temporary, will be reset in OEM
    realname: "OEM User"
  oem:
    install: auto
  shutdown: reboot
