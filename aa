#cloud-config
autoinstall:
  version: 1
  interactive-sections: []

  # Identity (user, host, password)
  identity:
    hostname: P250253.vito.local
    username: user
    # Use a proper SHA-512 hashed password; you can generate this using e.g. `mkpasswd -m sha-512`
    password: "$6$k1m2QA8VRaz78Leb$H9iQqtDFWDX8ojz6CO+wNVdzu1L97Q3ViFwUF2iz0hykO4j2W+S8pnbfUmI1ggDKA7h34/xWh43OlkIlRmudLA"

  # SSH configuration
  ssh:
    install-server: false
    allow-pw: false
    # optionally you can add `authorized-keys` here if you want key-based auth

  # Locale, keyboard, time zone
  locale: "en_US.UTF-8"
  keyboard:
    layout: be
    variant: ""
  timezone: "Europe/Brussels"

  # Network: simplest is DHCP
  network:
    version: 2
    ethernets:
      eth0:
        match:
          name: "*"
        dhcp4: true
        dhcp6: false

  # Storage layout
  storage:
    layout:
      name: direct   # or "lvm" or "zfs" depending on needs
    # You can also define more detailed partitions/config under storage.config if needed

  # Updates policy
  updates: security   # options: security, all, none

  # Commands to run late in the install (in the installed target system)
  late-commands:
    - curtin in-target -- apt update
    - curtin in-target -- apt upgrade -y

  # What to do on finish
  shutdown: reboot
